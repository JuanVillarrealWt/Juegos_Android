<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fisei.uta.edu.ec.flagquiz">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlagQuiz">

        <!-- MainActivity -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FlagQuiz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- SettingsActivity -->
        <activity
            android:name=".presentation.SettingsActivity"
            android:label="@string/settings"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".presentation.MainActivity"
            android:theme="@style/Theme.FlagQuiz">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="fisei.uta.edu.ec.flagquiz.presentation.MainActivity" />
        </activity>

    </application>
</manifest>
