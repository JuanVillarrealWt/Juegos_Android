<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AddressBookApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary branding color for the app (Indigo as in PDF). -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimary</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Accent color for FAB and highlights (Deep Orange as in PDF). -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/colorAccent</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Background & Surface - Clean White -->
        <item name="android:windowBackground">@color/background_white</item>
        <item name="android:colorBackground">@color/background_white</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Floating Action Button Theme -->
        <item name="floatingActionButtonStyle">@style/Widget.Material3.FloatingActionButton.Primary</item>
    </style>

    <style name="Theme.AddressBookApp" parent="Base.Theme.AddressBookApp" />
</resources>